# Notion API 연결 정보
# https://developers.notion.com/ 에서 통합을 만들고 토큰을 복사하세요
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 데이터베이스 ID
# 데이터베이스 URL에서 ID 부분을 복사하세요
# 예: https://www.notion.so/workspace/YOUR_DATABASE_ID_HERE?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx