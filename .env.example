# ===== Anthropic Claude API =====
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-여기에_발급받은_키를_붙여넣으세요

# ===== Notion API =====
# https://www.notion.so/my-integrations 에서 발급
NOTION_API_KEY=secret_여기에_발급받은_키를_붙여넣으세요

# 노션 데이터베이스 URL에서 복사 (32자리 영숫자)
NOTION_DATABASE_ID=여기에_데이터베이스_ID를_붙여넣으세요

# ===== (선택) Slack 알림 =====
# 실행 결과를 슬랙으로 받고 싶을 때만 설정
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
